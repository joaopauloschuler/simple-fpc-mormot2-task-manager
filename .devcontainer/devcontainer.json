{
  "name": "ai-coding-examples: Free Pascal",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/simple-fpc-mormot2-task-manager",
  "postCreateCommand": "./install_dependencies.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "alefragnani.pascal",
        "davidanson.vscode-markdownlint",
        "ms-vscode.vscode-container-tools"
      ]
    }
  }
}
